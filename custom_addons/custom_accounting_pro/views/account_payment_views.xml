<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Payment Form View -->
    <record id="view_payment_form_enhanced" model="ir.ui.view">
        <field name="name">account.payment.form.enhanced</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="batch_payment_id" widget="many2one" options="{'no_create': True}"/>
                <field name="mandate_id" widget="many2one" domain="[('partner_id', '=', partner_id)]"/>
                <field name="check_number"/>
                <field name="check_date"/>
                <field name="check_status"/>
            </xpath>
        </field>
    </record>

    <!-- Batch Payment Tree View -->
    <record id="view_batch_payment_tree" model="ir.ui.view">
        <field name="name">account.batch.payment.tree</field>
        <field name="model">account.batch.payment</field>
        <field name="arch" type="xml">
            <tree string="Batch Payments">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="total_amount"/>
                <field name="state"/>
                <field name="payment_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <!-- Batch Payment Form View -->
    <record id="view_batch_payment_form" model="ir.ui.view">
        <field name="name">account.batch.payment.form</field>
        <field name="model">account.batch.payment</field>
        <field name="arch" type="xml">
            <form string="Batch Payment">
                <header>
                    <button name="action_validate_batch" string="Validate Batch" type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="journal_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <field name="payment_ids">
                        <tree string="Payments">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Mandate Tree View -->
    <record id="view_payment_mandate_tree" model="ir.ui.view">
        <field name="name">account.payment.mandate.tree</field>
        <field name="model">account.payment.mandate</field>
        <field name="arch" type="xml">
            <tree string="Payment Mandates">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="bank_account_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <!-- Payment Mandate Form View -->
    <record id="view_payment_mandate_form" model="ir.ui.view">
        <field name="name">account.payment.mandate.form</field>
        <field name="model">account.payment.mandate</field>
        <field name="arch" type="xml">
            <form string="Payment Mandate">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="bank_account_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_batch_payment" model="ir.actions.act_window">
        <field name="name">Batch Payments</field>
        <field name="res_model">account.batch.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft':1}</field>
    </record>

    <record id="action_payment_mandate" model="ir.actions.act_window">
        <field name="name">Payment Mandates</field>
        <field name="res_model">account.payment.mandate</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
