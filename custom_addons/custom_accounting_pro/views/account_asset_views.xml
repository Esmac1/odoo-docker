<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asset Tree View -->
    <record id="view_asset_tree" model="ir.ui.view">
        <field name="name">custom_accounting.asset.tree</field>
        <field name="model">custom_accounting.asset</field>
        <field name="arch" type="xml">
            <tree string="Assets">
                <field name="name"/>
                <field name="code"/>
                <field name="value"/>
                <field name="acquisition_date"/>
                <field name="state"/>
                <field name="book_value"/>
            </tree>
        </field>
    </record>

    <!-- Asset Form View -->
    <record id="view_asset_form" model="ir.ui.view">
        <field name="name">custom_accounting.asset.form</field>
        <field name="model">custom_accounting.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'running')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="value"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="acquisition_date"/>
                            <field name="useful_life"/>
                            <field name="method"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="accumulated_depreciation"/>
                            <field name="book_value"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action for Assets -->
    <record id="action_custom_account_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">custom_accounting.asset</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft':1}</field>
    </record>
</odoo>
