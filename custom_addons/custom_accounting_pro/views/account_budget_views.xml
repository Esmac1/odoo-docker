<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget Tree View -->
    <record id="view_budget_tree" model="ir.ui.view">
        <field name="name">account.budget.tree</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <tree string="Budgets" decoration-success="state=='validated'" decoration-warning="state=='draft'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_budget"/>
                <field name="actual_spent"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Budget Form View -->
    <record id="view_budget_form" model="ir.ui.view">
        <field name="name">account.budget.form</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_set_draft" string="Set to Draft" type="object" class="btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'validated')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="total_budget"/>
                            <field name="actual_spent"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree string="Budget Lines" editable="bottom">
                            <field name="account_id"/>
                            <field name="planned_amount"/>
                            <field name="actual_amount"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Budgets -->
    <record id="action_account_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">account.budget</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft':1}</field>
    </record>
</odoo>
